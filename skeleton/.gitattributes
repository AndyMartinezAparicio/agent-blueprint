# Text files are stored with LF and checked out with LF on every OS,
# so Windows (core.autocrlf=true) stops warning on each `git add`.
* text=auto eol=lf

# Windows scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# gentle-ai skill-registry refresh writes this file with LF line endings.
.atl/skill-registry.md text eol=lf
